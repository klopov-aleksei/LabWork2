@startuml
!theme reddress-lightred

class Character {
    - m_name: std::string
    - m_strength: int
    - m_intelligence: int
    - m_agility: int
    - m_mana: int
    - m_maxMana: int
    - m_health: int
    - m_maxHealth: int
    - m_actionPoints: int
    - m_maxActionPoints: int
    - m_isBlocking: bool
    - m_attackCount: int
    - equippedWeapon: std::unique_ptr<Weapon> 
    - equippedArmor: std::unique_ptr<Armor>

    + Character(name: std::string_view, strength: int, intelligence: int, 
      agility: int, mana: int, health: int, actionPoints: int);
    + Character(name: std::string_view, agility: int, mana: int);
    + Character()
    + {virtual} ~Character()
    + setStats(strength: int, intelligence: int): void
    + setBlocking(state: bool): void
    + isBlocking(): bool
    + {virtual} resetActionPoints(): void
    + incrementAttackCount(): void
    + resetAttackCount(): void
    + getAttackCount(): int
    + getName(): const std::string&
    + getStrength(): int
    + getIntelligence(): int
    + getHealth(): int
    + getMaxHealth(): int
    + getAgility(): int
    + getActionPoints(): int
    + getMana(): int
    + isDead(): bool
    + increaseHealth(amount: int): void
    + increaseMana(amount: int): void
    + increaseMaxHealth(amount: int)
    + increaseMaxMana(amount: int): void
    + increaseStrength(amount: int): void
    + increaseIntelligence(amount: int): void
    + increaseAgility(amount: int): void
    + increaseActionPoints(amount: int): void
    + repairArmor(durability: int): void
    + repairWeapon(durability: int): void
    + {virtual} displayStatus(): void
    + equipWeapon(weapon: std::unique_ptr<Weapon>): void
    + equipArmor(armor: std::unique_ptr<Armor>): void
    + takeDamage(dmgCalc: DamageCalculator ): void
    + takeDamage(damage: int): void
    + takeActionPoints(cost: int): void
    + useMana(cost: int); void
    + getWeapon(): Weapon*
    + getArmor(): Armor*
}

class PlayerCharacter {
  - m_inventory: Inventory
  - hasSpellCastSkill: bool
  - canHeal: bool
  - monkTraining: bool
  - easyBlock: bool
  - investigateCost: int
  - strengthBonus: int
  
  + PlayerCharacter()
  + PlayerCharacter(name: std::string_view, agility: int, mana: int)
  + displayStatus(): void override
  + getInventory(): Inventory&
  + getInventory() const: const Inventory&
  + enableSpellCast()
  + unlockHealing()
  + boostConcentration()
  + reduceBlockCost()
  + canUseSpell(): bool
  + hasHealing(): bool
  + hasMonkTraining(): bool
  + hasEasyBlock(): bool
  + updateArmorBonuses(): void
  + getInvestigateCost(): int
  + getStrengthBonus(): int
}

class NPC {
  # m_hasBuff: bool
  # m_hasEquippedBackup: bool = false
  
  # {virtual} equipBackup(): void
  # {virtual} shouldUseUltra(playerHealthRatio: double, enemyHealthRatio: double): bool
  # shouldHeal(playerHealthRatio: double, enemyHealthRatio: double): bool
  # shouldRestoreMana(): bool
